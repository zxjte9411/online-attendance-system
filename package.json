{
  "name": "online-attendance-system",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "build": "vite build",
    "verify": "bun run typecheck && bun run test:unit && bun run build"
  },
  "dependencies": {
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
